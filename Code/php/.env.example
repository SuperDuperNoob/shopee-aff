# ------------------------------------------------------------------
# Credential auth (official Shopee Affiliate Open API / GraphQL).
# Set BOTH SHOPEE_API_APP_ID and SHOPEE_API_SECRET to use this mode.
# ------------------------------------------------------------------
SHOPEE_API_APP_ID=your_app_id_here
SHOPEE_API_SECRET=your_api_secret_here

# ------------------------------------------------------------------
# Cookie / session auth (Shopee web endpoints) - ALTERNATIVE to the
# credentials above. To use this mode, leave the credentials empty and
# set SHOPEE_COOKIE to the raw Cookie header copied from a logged-in
# browser session (e.g. SPC_F=...; SPC_EC=...; csrftoken=...).
# See COOKIE_AUTH.md at the repo root for how to obtain and use these.
# ------------------------------------------------------------------
# SHOPEE_COOKIE=SPC_F=your_session_cookie_here; SPC_EC=...; csrftoken=...
# SHOPEE_CSRF_TOKEN=your_csrf_token_here
# SHOPEE_ITEM_ID=
# SHOPEE_SHOP_ID=
